#!/bin/bash
# MAS (Multi-Agent System) Orchestrator v4.3.2
# Project-scoped shared context + per-agent MAS sessions + diagnostics
# Features: Adaptive context, Stage Gate, Context Maintenance System
#
# Runtime data lives in: ~/.openclaw/mas-hub/
# Project source lives in: ~/Projects/mas-hub/

set -u

MAS_VERSION="4.3.4"
MAS_HUB="${HOME}/.openclaw/mas-hub"
BLACKBOARD="${MAS_HUB}/blackboard"
DB_FILE="${BLACKBOARD}/shared_context.db"
LOCK_DIR="${BLACKBOARD}/.lock"
CONFIG_FILE="${MAS_HUB}/config.json"
LOG_FILE="${MAS_HUB}/logs/orchestrator.log"
STATE_FILE="${MAS_HUB}/state.json"
LEGACY_JSON="${BLACKBOARD}/shared_context.json"
MAS_TIMEOUT="${MAS_TIMEOUT:-600}"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'
NO_COLOR=0; OUTPUT_JSON=0
mkdir -p "${MAS_HUB}"/{inbox,outbox,blackboard,workflows,logs,agent-memories}

auto_color(){ if [[ "$NO_COLOR" -eq 1 || ! -t 1 ]]; then RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; BOLD=''; DIM=''; NC=''; fi; }
auto_color

# ─── Trap-based lock cleanup ───
_mas_cleanup(){
  release_lock
}
trap _mas_cleanup EXIT INT TERM

# ─── Logging ───
log(){
  local level="$1"; shift
  printf '[%s] [%s] %s\n' "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$level" "$*" >> "$LOG_FILE"
}

# ─── JSON error envelope ───
emit_error(){
  local stage="$1" msg="$2" hint="${3:-}"
  log ERROR "stage=$stage msg=$msg"
  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    python3 <<PY
import json
print(json.dumps({
  'status':'error','stage':'$stage',
  'project':'${CURRENT_PROJECT:-}','mas_session_id':'${CURRENT_SID:-}',
  'message':'''$msg''','hint':'''$hint'''
}, ensure_ascii=False, indent=2))
PY
  else
    echo -e "${RED}Error [$stage]:${NC} $msg"
    [[ -n "$hint" ]] && echo -e "${DIM}Hint: $hint${NC}"
  fi
}

# ─── Utilities ───
slugify(){ printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//; s/--+/-/g'; }

read_config_agent_field(){ local agent="$1" field="$2"; python3 <<PY
import json
try:
    with open("$CONFIG_FILE") as f: data=json.load(f)
    print(((data.get('agents') or {}).get('$agent') or {}).get('$field',''))
except Exception: print('')
PY
}

list_config_agents(){ python3 <<PY
import json
try:
    with open("$CONFIG_FILE") as f: data=json.load(f)
    for k in (data.get('agents') or {}).keys(): print(k)
except Exception: print('archie'); print('wang'); print('lynch')
PY
}

normalize_agent(){
  case "$1" in
    bob|@bob|bootstrap|@bootstrap) echo "bootstrap" ;;
    archie|@archie) echo "archie" ;;
    wang|@wang) echo "wang" ;;
    lynch|@lynch) echo "lynch" ;;
    alonzo|@alonzo) echo "alonzo" ;;
    @*) echo "${1#@}" ;;
    *) echo "$1" ;;
  esac
}

get_agent_id(){
  local a; a=$(normalize_agent "$1")
  local cfg; cfg=$(read_config_agent_field "$a" "id")
  [[ -n "$cfg" ]] && { echo "$cfg"; return; }
  case "$a" in archie) echo "main" ;; *) echo "$a" ;; esac
}

get_agent_name(){
  local a; a=$(normalize_agent "$1")
  local cfg; cfg=$(read_config_agent_field "$a" "name")
  [[ -n "$cfg" ]] && { echo "$cfg"; return; }
  case "$a" in archie) echo "Archie" ;; wang) echo "Wang" ;; lynch) echo "Lynch" ;; bootstrap) echo "Bootstrap" ;; *) echo "$a" ;; esac
}

# ─── Locking (with stale detection) ───
acquire_lock(){
  local waited=0
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    sleep 0.1; waited=$((waited+1))
    if [[ $waited -ge 300 ]]; then
      # Stale lock detection: if lock dir is older than 120s, remove it
      if [[ -d "$LOCK_DIR" ]]; then
        local lock_age
        lock_age=$(( $(date +%s) - $(stat -f %m "$LOCK_DIR" 2>/dev/null || echo 0) ))
        if [[ $lock_age -gt 120 ]]; then
          log WARN "Removing stale lock (age=${lock_age}s)"
          rmdir "$LOCK_DIR" 2>/dev/null
          continue
        fi
      fi
      emit_error "lock_timeout" "Timed out waiting for MAS blackboard lock" "Run: rmdir ~/.openclaw/mas-hub/blackboard/.lock"
      return 1
    fi
  done
}

release_lock(){ rmdir "$LOCK_DIR" 2>/dev/null || true; }

# ─── Database ───
ensure_db(){ python3 <<PY
import sqlite3, os
path=os.path.expanduser("$DB_FILE"); os.makedirs(os.path.dirname(path), exist_ok=True)
conn=sqlite3.connect(path); cur=conn.cursor()
cur.execute('''CREATE TABLE IF NOT EXISTS exchanges (
 id INTEGER PRIMARY KEY AUTOINCREMENT, turn_id TEXT UNIQUE, project TEXT, mas_session_id TEXT, date TEXT,
 timestamp TEXT, time_hm TEXT, agent TEXT, agent_id TEXT, agent_session_id TEXT,
 user_request TEXT, response_text TEXT, response_summary TEXT,
 key_points_json TEXT, open_questions_json TEXT, citations_json TEXT, artifacts_json TEXT,
 status TEXT, error_text TEXT)''')
cur.execute('''CREATE TABLE IF NOT EXISTS mas_agent_sessions (
 project TEXT, mas_session_id TEXT, agent TEXT, agent_id TEXT, openclaw_session_id TEXT,
 created_at TEXT, updated_at TEXT, PRIMARY KEY (mas_session_id, agent))''')
cur.execute('''CREATE TABLE IF NOT EXISTS mas_meta (key TEXT PRIMARY KEY, value TEXT)''')
# Migrate v4.0/v4.1 DBs (add project column if missing)
for table, cols in {
    'exchanges': {'project': "ALTER TABLE exchanges ADD COLUMN project TEXT DEFAULT 'default'"},
    'mas_agent_sessions': {'project': "ALTER TABLE mas_agent_sessions ADD COLUMN project TEXT DEFAULT 'default'"},
}.items():
    existing = {row[1] for row in cur.execute(f"PRAGMA table_info({table})")}
    for col, ddl in cols.items():
        if col not in existing: cur.execute(ddl)
cur.execute("UPDATE exchanges SET project='default' WHERE project IS NULL OR project=''")
cur.execute("UPDATE mas_agent_sessions SET project='default' WHERE project IS NULL OR project=''")
cur.execute("CREATE INDEX IF NOT EXISTS idx_ex_proj_sess ON exchanges(project, mas_session_id, id)")
cur.execute("CREATE INDEX IF NOT EXISTS idx_ex_proj ON exchanges(project, id)")
conn.commit(); conn.close()
PY
}

mark_meta(){ python3 <<PY
import sqlite3
conn=sqlite3.connect("$DB_FILE"); cur=conn.cursor()
cur.execute("INSERT INTO mas_meta(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value", ("$1","$2"))
conn.commit(); conn.close()
PY
}
get_meta(){ python3 <<PY
import sqlite3
conn=sqlite3.connect("$DB_FILE"); cur=conn.cursor()
cur.execute("SELECT value FROM mas_meta WHERE key=?", ("$1",)); row=cur.fetchone()
print(row[0] if row else ''); conn.close()
PY
}

migrate_legacy_json_if_needed(){
  ensure_db
  local migrated; migrated=$(get_meta "legacy_json_migrated_v2")
  [[ "$migrated" == "yes" ]] && return 0
  [[ ! -f "$LEGACY_JSON" ]] && { mark_meta "legacy_json_migrated_v2" "yes"; return 0; }
  python3 <<PY
import json, sqlite3, uuid, os
legacy=os.path.expanduser("$LEGACY_JSON"); db=os.path.expanduser("$DB_FILE")
with open(legacy) as f: data=json.load(f)
exchanges=data.get('exchanges',[]); conn=sqlite3.connect(db); cur=conn.cursor()
project='legacy'; mas_session_id='legacy-'+(data.get('date') or 'unknown')
for ex in exchanges:
    cur.execute('''INSERT OR IGNORE INTO exchanges (turn_id,project,mas_session_id,date,timestamp,time_hm,agent,agent_id,agent_session_id,user_request,response_text,response_summary,key_points_json,open_questions_json,citations_json,artifacts_json,status,error_text) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)''',
    (str(uuid.uuid4()),project,mas_session_id,data.get('date',''),data.get('date','')+'T00:00:00Z' if data.get('date') else '',ex.get('time',''),ex.get('agent','unknown'),ex.get('agent',''),'',ex.get('input',''),ex.get('output_summary',''),ex.get('output_summary',''),'[]','[]','[]','[]','legacy_import','Imported from legacy shared_context.json'))
conn.commit(); conn.close(); print(f'Migrated {len(exchanges)} legacy exchanges into SQLite')
PY
  mark_meta "legacy_json_migrated_v2" "yes"
  log INFO "Migrated legacy shared_context.json into SQLite"
}

# ─── State ───
init_state(){
  if [[ ! -f "$STATE_FILE" ]]; then
    cat > "$STATE_FILE" <<EOF
{"current_project":"default","current_mas_session_id":"mas-default-$(date +%Y%m%d)","created":"$(date -u +"%Y-%m-%dT%H:%M:%SZ")"}
EOF
  fi
}
get_state_field(){ init_state; python3 <<PY
import json
with open("$STATE_FILE") as f: data=json.load(f)
print(data.get("$1",""))
PY
}
set_state_fields(){ python3 <<PY
import json
path="$STATE_FILE"
with open(path) as f: data=json.load(f)
data['current_project']="$1"; data['current_mas_session_id']="$2"
with open(path,'w') as f: json.dump(data,f,indent=2)
PY
}
get_current_project(){ get_state_field current_project; }
get_current_mas_session_id(){ get_state_field current_mas_session_id; }

# ─── Project management ───
new_project(){
  local raw="$1"; [[ -z "$raw" ]] && { emit_error "usage" "Usage: mas new <project-name>"; return 1; }
  local project; project=$(slugify "$raw")
  local sid="mas-${project}-$(date +%Y%m%d-%H%M%S)"
  set_state_fields "$project" "$sid"
  CURRENT_PROJECT="$project"; CURRENT_SID="$sid"
  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    printf '{"status":"ok","project":"%s","mas_session_id":"%s"}\n' "$project" "$sid"
  else
    echo -e "${GREEN}✓${NC} Started project '${BOLD}$project${NC}' with MAS session: $sid"
  fi
}

use_project(){
  local raw="$1"; [[ -z "$raw" ]] && { emit_error "usage" "Usage: mas use <project-name>"; return 1; }
  local project; project=$(slugify "$raw")
  local sid; sid=$(python3 <<PY
import sqlite3
conn=sqlite3.connect("$DB_FILE"); cur=conn.cursor()
cur.execute("SELECT mas_session_id FROM exchanges WHERE project=? ORDER BY id DESC LIMIT 1", ("$project",))
row=cur.fetchone(); conn.close(); print(row[0] if row else '')
PY
)
  [[ -z "$sid" ]] && sid="mas-${project}-$(date +%Y%m%d-%H%M%S)"
  set_state_fields "$project" "$sid"
  CURRENT_PROJECT="$project"; CURRENT_SID="$sid"
  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    printf '{"status":"ok","project":"%s","mas_session_id":"%s"}\n' "$project" "$sid"
  else
    echo -e "${GREEN}✓${NC} Now using project '${BOLD}$project${NC}' (MAS session: $sid)"
  fi
}

list_projects(){
  python3 <<PY
import sqlite3, json
conn=sqlite3.connect("$DB_FILE"); cur=conn.cursor()
cur.execute("SELECT project, COUNT(*), MAX(timestamp) FROM exchanges GROUP BY project ORDER BY MAX(timestamp) DESC")
rows=cur.fetchall(); conn.close()
out=[{'project':p,'exchange_count':c,'last_timestamp':ts} for p,c,ts in rows if p]
if $OUTPUT_JSON:
    print(json.dumps({'current_project':'$CURRENT_PROJECT','current_mas_session_id':'$CURRENT_SID','projects':out}, ensure_ascii=False, indent=2))
else:
    print(f"Current project: $CURRENT_PROJECT")
    print(f"Current MAS session: $CURRENT_SID\n")
    if out:
        for row in out:
            marker=' ←' if row['project']=='$CURRENT_PROJECT' else ''
            print(f"  {row['project']}: {row['exchange_count']} exchanges (last: {row['last_timestamp']}){marker}")
    else: print('No projects yet.')
PY
}

show_project_quick(){
  echo -e "${BOLD}$CURRENT_PROJECT${NC} → $CURRENT_SID"
}

# ─── Agent sessions ───
get_or_create_agent_session(){
  local mas_session_id="$1" project="$2" agent="$3" agent_id="$4"
  python3 <<PY
import sqlite3
from datetime import datetime, UTC
conn=sqlite3.connect("$DB_FILE"); cur=conn.cursor()
cur.execute("SELECT openclaw_session_id FROM mas_agent_sessions WHERE mas_session_id=? AND agent=?", ("$mas_session_id","$agent"))
row=cur.fetchone()
if row: print(row[0])
else:
    sid="mas::"+"$project"+"::"+"$agent"
    now=datetime.now(UTC).strftime('%Y-%m-%dT%H:%M:%SZ')
    cur.execute("INSERT INTO mas_agent_sessions (project,mas_session_id,agent,agent_id,openclaw_session_id,created_at,updated_at) VALUES (?,?,?,?,?,?,?)",
                ("$project","$mas_session_id","$agent","$agent_id",sid,now,now))
    conn.commit(); print(sid)
conn.close()
PY
}

# ─── Context retrieval ───
get_context_for_agent(){
  local mas_session_id="$1" mode="${2:-text}"
  # Use adaptive context assembly with relevance scoring
  python3 /tmp/mas_context.py "$DB_FILE" "$mas_session_id" "$CURRENT_PROJECT" "$mode"
}


# ─── Response extraction (hardened) ───
extract_structured_response(){
  local response_file="$1"
  python3 <<PY
import json, textwrap, re, sys
try:
    with open("$response_file") as f: raw = f.read()
except Exception as e:
    print(json.dumps({'_error': True, '_stage': 'file_read', '_msg': str(e)})); sys.exit(0)
try:
    data = json.loads(raw)
except json.JSONDecodeError as e:
    print(json.dumps({'_error': True, '_stage': 'json_parse', '_msg': f'Invalid JSON: {e}', '_raw_head': raw[:200]})); sys.exit(0)
# Support both old format {"status":"ok","result":{"payloads":[...]}} and new format {"payloads":[...],"meta":{...}}
if 'payloads' in data and 'status' not in data:
    # New openclaw agent --json format: payloads at top level
    payloads = data.get('payloads') or []
elif data.get('status') == 'ok':
    result = data.get('result') or {}
    payloads = result.get('payloads') or []
else:
    print(json.dumps({'_error': True, '_stage': 'agent_status', '_msg': f"Agent returned status={data.get('status')}", '_detail': data.get('error', '')})); sys.exit(0)
texts = [p.get('text','').strip() for p in payloads if isinstance(p, dict) and p.get('text') and p.get('text').strip()]
if not texts:
    print(json.dumps({'_error': True, '_stage': 'empty_payload', '_msg': 'No non-empty text payloads', '_payloads': len(payloads)})); sys.exit(0)
text = '\n\n'.join(texts).strip()
summary = textwrap.shorten(' '.join(text.split()), width=280, placeholder='...')
paragraphs = [p.strip().replace('\n',' ') for p in text.split('\n') if p.strip()]
key_points = []
for p in paragraphs:
    clean = p.lstrip('-•*0123456789. )(').strip()
    if clean and clean not in key_points: key_points.append(textwrap.shorten(clean, width=160, placeholder='...'))
    if len(key_points) >= 5: break
open_questions = []
for line in paragraphs:
    low = line.lower()
    if '?' in line or low.startswith('open question') or 'unclear' in low or 'need ' in low or 'unknown' in low:
        open_questions.append(textwrap.shorten(line, width=160, placeholder='...'))
    if len(open_questions) >= 3: break
citations = []
for m in re.findall(r'https?://\S+', text):
    c = m.rstrip(').,]')
    if c not in citations: citations.append(c)
    if len(citations) >= 5: break
artifacts = []
for line in paragraphs:
    if any(tok in line.lower() for tok in ['attached','artifact','file:','.pdf','.csv','.xlsx','.md']):
        artifacts.append(textwrap.shorten(line, width=180, placeholder='...'))
    if len(artifacts) >= 5: break
# Support both old format (result.meta.agentMeta) and new format (meta.agentMeta)
meta = (((data.get('result') or {}).get('meta') or {}).get('agentMeta') or {}) or ((data.get('meta') or {}).get('agentMeta') or {})
print(json.dumps({'text':text,'summary':summary,'key_points':key_points,'open_questions':open_questions,'citations':citations,'artifacts':artifacts,'agent_session_id':meta.get('sessionId',''),'provider':meta.get('provider',''),'model':meta.get('model','')}, ensure_ascii=False))
PY
}

check_extraction_error(){
  local struct_file="$1"
  python3 <<PY
import json, sys
with open("$struct_file") as f: s=json.load(f)
if s.get('_error'):
    print(f"{s.get('_stage','unknown')}|{s.get('_msg','Unknown error')}")
    sys.exit(1)
sys.exit(0)
PY
}

# ─── Exchange persistence ───
add_exchange(){
  local project="$1" mas_session_id="$2" agent="$3" agent_id="$4" agent_session_id="$5" request_file="$6" struct_file="$7" status="$8" error_text_file="${9:-}"
  python3 <<PY
import sqlite3, json, uuid
from datetime import datetime, UTC
with open("$request_file") as f: req=f.read()
with open("$struct_file") as f: s=json.load(f)
err=None
if "$error_text_file":
    try:
        with open("$error_text_file") as f: err=f.read()
    except: err=None
now=datetime.now(UTC); conn=sqlite3.connect("$DB_FILE"); cur=conn.cursor()
cur.execute("""INSERT INTO exchanges (turn_id,project,mas_session_id,date,timestamp,time_hm,agent,agent_id,agent_session_id,user_request,response_text,response_summary,key_points_json,open_questions_json,citations_json,artifacts_json,status,error_text) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
(str(uuid.uuid4()),"$project","$mas_session_id",now.strftime('%Y-%m-%d'),now.strftime('%Y-%m-%dT%H:%M:%SZ'),now.strftime('%H:%M'),"$agent","$agent_id","$agent_session_id",req,s.get('text',''),s.get('summary',''),json.dumps(s.get('key_points',[]),ensure_ascii=False),json.dumps(s.get('open_questions',[]),ensure_ascii=False),json.dumps(s.get('citations',[]),ensure_ascii=False),json.dumps(s.get('artifacts',[]),ensure_ascii=False),"$status",err))
cur.execute("UPDATE mas_agent_sessions SET updated_at=? WHERE mas_session_id=? AND agent=?", (now.strftime('%Y-%m-%dT%H:%M:%SZ'),"$mas_session_id","$agent"))
conn.commit(); conn.close()
PY
}

append_agent_memory(){
  local agent="$1" request_file="$2" struct_file="$3"
  local mem_file="${MAS_HUB}/agent-memories/${agent}_$(date +%F).md"
  python3 <<PY >> "$mem_file"
import json
from datetime import datetime
with open("$request_file") as f: req=f.read().strip()
with open("$struct_file") as f: s=json.load(f)
print(f"## {datetime.now().strftime('%H:%M:%S')} [$CURRENT_PROJECT]")
print(); print(f"**Input:** {req}"); print(); print(f"**Summary:** {s.get('summary','')}")
if s.get('key_points'): print(); print('**Key Points:**'); [print(f'- {x}') for x in s['key_points'][:5]]
print(); print('---'); print()
PY
}

# ─── Model switching ───
agent_index_for_model(){
  # Indices from: openclaw config get agents.list
  # 0=main(Archie) 1=work 2=wang 3=lynch 4=bootstrap 5=alonzo
  case "$1" in archie) echo 0 ;; wang) echo 2 ;; lynch) echo 3 ;; bootstrap) echo 4 ;; alonzo) echo 5 ;; *) echo "" ;; esac
}

resolve_model_alias(){
  case "$1" in
    claude-opus-4|opus4) echo "zenmux/anthropic/claude-opus-4" ;;
    claude-opus-4.6|opus|claude) echo "zenmux/anthropic/claude-opus-4.6" ;;
    claude-sonnet-4.6|sonnet|sonnet46) echo "zenmux/anthropic/claude-sonnet-4-6" ;;
    gpt-4.1-mini|gpt|mini) echo "zenmux/openai/gpt-4.1-mini" ;;
    gpt-5.4|gpt54) echo "zenmux/openai/gpt-5.4" ;;
    gpt-5.3-codex|codex|coding) echo "zenmux/openai/gpt-5.3-codex" ;;
    qwen-3.5-plus|qwen35|qwen) echo "zenmux/qwen/qwen3.5-plus" ;;
    qwen-3-max|qwen3) echo "zenmux/qwen/qwen3-max" ;;
    glm-5-turbo|glm|glm5) echo "zenmux/z-ai/glm-5-turbo" ;;
    doubao-seed|doubao) echo "zenmux/volcengine/doubao-seed-2.0-pro" ;;
    grok-4.2|grok|fast) echo "zenmux/x-ai/grok-4.2-fast" ;;
    kimi|moonshot) echo "moonshot/kimi-k2.5" ;;
    minimax|minimax-m2.7|m2.7) echo "minimax/MiniMax-M2.7" ;;
    local-qwen|qwen-local|qwen9b) echo "ollama/qwen3.5:9b" ;;
    local-phi4|phi4|phi) echo "ollama/phi4:latest" ;;
    *) echo "$1" ;;
  esac
}

show_model(){
  local agent; agent=$(normalize_agent "$1")
  local idx; idx=$(agent_index_for_model "$agent")
  [[ -z "$idx" ]] && { emit_error "model" "Unknown agent: $agent"; return 1; }
  local path="agents.list[${idx}].model.primary"
  local model; model=$(openclaw config get "$path" 2>/dev/null)
  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    printf '{"agent":"%s","model":"%s"}\n' "$agent" "$model"
  else
    echo -e "$(get_agent_name "$agent"): ${BOLD}$model${NC}"
  fi
}

set_model(){
  local agent; agent=$(normalize_agent "$1"); local alias="$2"
  local idx; idx=$(agent_index_for_model "$agent")
  [[ -z "$idx" ]] && { emit_error "model" "Unknown agent: $agent"; return 1; }
  local model; model=$(resolve_model_alias "$alias")
  local path="agents.list[${idx}].model.primary"
  openclaw config set "$path" "$model" >/dev/null 2>&1
  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    printf '{"status":"ok","agent":"%s","model":"%s"}\n' "$agent" "$model"
  else
    echo -e "${GREEN}✓${NC} $(get_agent_name "$agent") → ${BOLD}$model${NC}"
  fi
}

models_overview(){
  echo -e "${BOLD}Current agent models:${NC}"
  for agent in archie wang lynch alonzo bootstrap; do
    local idx; idx=$(agent_index_for_model "$agent")
    local path="agents.list[${idx}].model.primary"
    local model; model=$(openclaw config get "$path" 2>/dev/null)
    echo -e "  $(get_agent_name "$agent"): ${CYAN}$model${NC}"
  done
}

model_menu(){
  local agent; agent=$(normalize_agent "$1")
  echo -e "${BOLD}Select model for $(get_agent_name "$agent"):${NC}"
  echo "  1) Claude Opus 4         2) Claude Opus 4.6       3) Claude Sonnet 4.6"
  echo "  4) GPT-4.1 Mini          5) GPT-5.4               6) GPT-5.3 Codex"
  echo "  7) Qwen 3.5 Plus         8) Qwen 3 Max            9) GLM-5 Turbo"
  echo " 10) Doubao Seed 2.0      11) Grok 4.2 Fast        12) Kimi K2.5"
  echo " 13) MiniMax M2.7        14) Local Qwen 3.5 9B    15) Local Phi-4"
  echo "  c) Current model         q) Cancel"
  echo -n "Choice: "; read choice
  case "$choice" in
    1) set_model "$agent" claude-opus-4 ;; 2) set_model "$agent" claude-opus-4.6 ;;
    3) set_model "$agent" claude-sonnet-4.6 ;; 4) set_model "$agent" gpt-4.1-mini ;;
    5) set_model "$agent" gpt-5.4 ;; 6) set_model "$agent" gpt-5.3-codex ;;
    7) set_model "$agent" qwen-3.5-plus ;; 8) set_model "$agent" qwen-3-max ;;
    9) set_model "$agent" glm-5-turbo ;; 10) set_model "$agent" doubao-seed ;;
    11) set_model "$agent" grok-4.2 ;; 12) set_model "$agent" kimi ;;
    13) set_model "$agent" minimax ;; 14) set_model "$agent" local-qwen ;;
    15) set_model "$agent" local-phi4 ;;
    c|C) show_model "$agent" ;; *) echo "Cancelled." ;;
  esac
}

# ─── Send to agent (hardened) ───
send_to_agent(){
  local agent="$1"; shift; local message="$*"
  agent=$(normalize_agent "$agent")
  local agent_id agent_name agent_session_id context
  agent_id=$(get_agent_id "$agent")
  agent_name=$(get_agent_name "$agent")

  ensure_db; migrate_legacy_json_if_needed

  # Stage 1: Lock + session setup
  acquire_lock || return 1
  agent_session_id=$(get_or_create_agent_session "$CURRENT_SID" "$CURRENT_PROJECT" "$agent" "$agent_id")
  context=$(get_context_for_agent "$CURRENT_SID")
  release_lock

  local req_file; req_file=$(mktemp)
  printf '%s' "$message" > "$req_file"

  local full_message="$context

PROJECT: $CURRENT_PROJECT
YOUR TURN - $agent_name:
User request: $message

Instructions:
- Use the shared MAS context above when relevant.
- Keep your agent-specific reasoning/session continuity.
- Stay scoped to project '$CURRENT_PROJECT' unless asked otherwise.
- Return a direct answer, with clear bullets if helpful.
- Surface unresolved questions explicitly when relevant.
- Include links/citations when available."

  [[ "$OUTPUT_JSON" -eq 0 ]] && echo -e "Sending to ${BOLD}$agent_name${NC} [project: $CURRENT_PROJECT]..."
  log INFO "stage=agent_call agent=$agent project=$CURRENT_PROJECT session=$CURRENT_SID agent_session=$agent_session_id timeout=${MAS_TIMEOUT}s"

  # Stage 2: Agent call
  local output_file err_file exit_code t_start t_end duration_ms
  output_file=$(mktemp); err_file=$(mktemp)
  t_start=$(date +%s)
  openclaw agent --agent "$agent_id" --session-id "$agent_session_id" --message "$full_message" --json --timeout "$MAS_TIMEOUT" > "$output_file" 2> "$err_file"
  exit_code=$?
  t_end=$(date +%s)
  duration_ms=$(( (t_end - t_start) * 1000 ))

  if [[ $exit_code -ne 0 ]]; then
    local err_tail; err_tail=$(tail -5 "$err_file" 2>/dev/null | tr '\n' ' ')
    log ERROR "stage=agent_call agent=$agent exit=$exit_code duration=${duration_ms}ms err=$err_tail"
    emit_error "agent_call" "Agent call failed (exit=$exit_code, ${duration_ms}ms)" "Check model availability: mas model $agent current"
    [[ "$OUTPUT_JSON" -eq 0 ]] && { echo -e "${DIM}"; tail -10 "$err_file" 2>/dev/null; echo -e "${NC}"; }
    rm -f "$req_file" "$output_file" "$err_file"
    return 1
  fi

  log INFO "stage=agent_call_ok agent=$agent duration=${duration_ms}ms"

  # Stage 3: Parse response
  local struct_file; struct_file=$(mktemp)
  extract_structured_response "$output_file" > "$struct_file" 2>> "$err_file"

  local parse_err
  if parse_err=$(check_extraction_error "$struct_file" 2>&1); then
    : # no error
  else
    local err_stage err_msg
    err_stage=$(echo "$parse_err" | cut -d'|' -f1)
    err_msg=$(echo "$parse_err" | cut -d'|' -f2-)
    log ERROR "stage=parse_response agent=$agent sub_stage=$err_stage msg=$err_msg"
    emit_error "parse_response" "$err_msg (sub-stage: $err_stage)" "The agent responded but the output was unparseable."
    rm -f "$req_file" "$output_file" "$struct_file" "$err_file"
    return 1
  fi

  log INFO "stage=parse_ok agent=$agent"

  # Extract real agent session id if returned
  local real_sid
  real_sid=$(python3 - <<PY
import json
with open("$struct_file") as f: s=json.load(f)
print(s.get('agent_session_id',''))
PY
)
  [[ -n "$real_sid" ]] && agent_session_id="$real_sid"

  # Stage 4: Persist to blackboard
  acquire_lock || return 1
  add_exchange "$CURRENT_PROJECT" "$CURRENT_SID" "$agent" "$agent_id" "$agent_session_id" "$req_file" "$struct_file" complete "$err_file"
  append_agent_memory "$agent" "$req_file" "$struct_file"
  release_lock

  log INFO "stage=db_write_ok agent=$agent project=$CURRENT_PROJECT"

  # Stage 5: Output
  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    python3 <<PY
import json
with open("$struct_file") as f: s=json.load(f)
print(json.dumps({'status':'ok','project':'$CURRENT_PROJECT','mas_session_id':'$CURRENT_SID','agent':'$agent','agent_id':'$agent_id','agent_name':'$agent_name','agent_session_id':'$agent_session_id','duration_ms':$duration_ms,'response':s}, ensure_ascii=False, indent=2))
PY
  else
    local text; text=$(python3 - <<PY
import json
with open("$struct_file") as f: s=json.load(f)
print(s.get('text',''))
PY
)
    echo ""
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "${BLUE}${agent_name} [MAS:${CURRENT_PROJECT}]:${NC} ${DIM}(${duration_ms}ms)${NC}"
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo "$text"
    echo ""
  fi

  rm -f "$req_file" "$output_file" "$struct_file" "$err_file"
}

broadcast(){
  local agents; agents=$(list_config_agents)
  [[ -z "$agents" ]] && agents=$'archie\nwang\nlynch'
  while IFS= read -r agent; do
    [[ -z "$agent" ]] && continue
    send_to_agent "$agent" "$1"
    [[ "$OUTPUT_JSON" -eq 0 ]] && echo ""
  done <<< "$agents"
}

# ─── Send to agent (silent, returns text via MAS_LEAD_RESPONSE_FILE) ───
# Same as send_to_agent but writes response text to a temp file instead of stdout
# Sets MAS_LEAD_RESPONSE_FILE on success, returns 1 on failure
send_to_agent_silent(){
  local agent="$1"; shift; local message="$*"
  agent=$(normalize_agent "$agent")
  local agent_id agent_name agent_session_id context
  agent_id=$(get_agent_id "$agent")
  agent_name=$(get_agent_name "$agent")

  acquire_lock || return 1
  agent_session_id=$(get_or_create_agent_session "$CURRENT_SID" "$CURRENT_PROJECT" "$agent" "$agent_id")
  context=$(get_context_for_agent "$CURRENT_SID")
  release_lock

  local req_file; req_file=$(mktemp)
  printf '%s' "$message" > "$req_file"

  local full_message="$context

PROJECT: $CURRENT_PROJECT
YOUR TURN - $agent_name:
User request: $message

Instructions:
- Use the shared MAS context above when relevant.
- Keep your agent-specific reasoning/session continuity.
- Stay scoped to project '$CURRENT_PROJECT' unless asked otherwise.
- Return a direct answer, with clear bullets if helpful.
- Surface unresolved questions explicitly when relevant.
- Include links/citations when available."

  log INFO "stage=lead_dispatch agent=$agent project=$CURRENT_PROJECT session=$CURRENT_SID"

  local output_file err_file exit_code t_start t_end duration_ms
  output_file=$(mktemp); err_file=$(mktemp)
  t_start=$(date +%s)
  openclaw agent --agent "$agent_id" --session-id "$agent_session_id" --message "$full_message" --json --timeout "$MAS_TIMEOUT" > "$output_file" 2> "$err_file"
  exit_code=$?
  t_end=$(date +%s)
  duration_ms=$(( (t_end - t_start) * 1000 ))

  if [[ $exit_code -ne 0 ]]; then
    log ERROR "stage=lead_dispatch_fail agent=$agent exit=$exit_code"
    echo -e "  ${RED}✗${NC} $agent_name failed (exit=$exit_code, ${duration_ms}ms)"
    rm -f "$req_file" "$output_file" "$err_file"
    MAS_LEAD_RESPONSE_FILE=""
    return 1
  fi

  local struct_file; struct_file=$(mktemp)
  extract_structured_response "$output_file" > "$struct_file" 2>> "$err_file"

  if ! check_extraction_error "$struct_file" >/dev/null 2>&1; then
    local parse_detail; parse_detail=$(cat "$struct_file" 2>/dev/null | head -3)
    local err_detail; err_detail=$(tail -5 "$err_file" 2>/dev/null | tr '\n' ' ')
    log ERROR "stage=lead_parse_fail agent=$agent parse_detail=$parse_detail err=$err_detail"
    echo -e "  ${YELLOW}⚠${NC} $agent_name: response parse issue, retrying..."
    echo -e "  ${DIM}$parse_detail${NC}"
    # Retry once with a fresh call
    rm -f "$output_file" "$struct_file"
    output_file=$(mktemp); struct_file=$(mktemp)
    t_start=$(date +%s)
    openclaw agent --agent "$agent_id" --session-id "$agent_session_id" --message "$full_message" --json --timeout "$MAS_TIMEOUT" > "$output_file" 2>> "$err_file"
    exit_code=$?; t_end=$(date +%s); duration_ms=$(( (t_end - t_start) * 1000 ))
    if [[ $exit_code -ne 0 ]]; then
      echo -e "  ${RED}✗${NC} $agent_name retry also failed (exit=$exit_code)"
      rm -f "$req_file" "$output_file" "$struct_file" "$err_file"
      MAS_LEAD_RESPONSE_FILE=""
      return 1
    fi
    extract_structured_response "$output_file" > "$struct_file" 2>> "$err_file"
    if ! check_extraction_error "$struct_file" >/dev/null 2>&1; then
      echo -e "  ${RED}✗${NC} $agent_name retry also unparseable"
      rm -f "$req_file" "$output_file" "$struct_file" "$err_file"
      MAS_LEAD_RESPONSE_FILE=""
      return 1
    fi
    echo -e "  ${GREEN}✓${NC} Retry succeeded"
  fi

  local real_sid
  real_sid=$(python3 - <<PY
import json
with open("$struct_file") as f: s=json.load(f)
print(s.get('agent_session_id',''))
PY
)
  [[ -n "$real_sid" ]] && agent_session_id="$real_sid"

  acquire_lock || return 1
  add_exchange "$CURRENT_PROJECT" "$CURRENT_SID" "$agent" "$agent_id" "$agent_session_id" "$req_file" "$struct_file" complete "$err_file"
  append_agent_memory "$agent" "$req_file" "$struct_file"
  release_lock

  local text
  text=$(python3 - <<PY
import json
with open("$struct_file") as f: s=json.load(f)
print(s.get('text',''))
PY
)

  # Print agent response compactly
  echo ""
  echo -e "  ${CYAN}───${NC} ${BLUE}${agent_name}${NC} ${DIM}(${duration_ms}ms)${NC} ${CYAN}───${NC}"
  echo "$text" | sed 's/^/  /'
  echo ""

  # Write to response file for lead loop
  local resp_file; resp_file=$(mktemp)
  echo "$text" > "$resp_file"
  MAS_LEAD_RESPONSE_FILE="$resp_file"

  rm -f "$req_file" "$output_file" "$struct_file" "$err_file"
  return 0
}

# ─── Lead mode v2: autonomous facilitation with watchdog ───
#
# Features:
#   1. Task deadline tracking (issued_at, soft/hard deadlines)
#   2. Auto timeout checks between rounds
#   3. Auto-escalation to Bootstrap on hard timeout
#   4. Configurable lead-mode controls
#   5. Stall-safe synthesis (partial output when agents stall)
#
# Controls (env vars):
#   MAS_LEAD_MAX_ROUNDS=10        Max facilitation rounds
#   MAS_LEAD_SOFT_TIMEOUT=300     Soft timeout per task (seconds) — warn (5 min)
#   MAS_LEAD_HARD_TIMEOUT=900     Hard timeout per task (seconds) — escalate (15 min)
#   MAS_LEAD_ESCALATE_AGENT=bootstrap  Agent to escalate stalls to
#   MAS_LEAD_STALL_ACTION=partial      Action on stall: partial|abort|reassign
#
# Note: Equity research tasks often take 5-15 minutes. Timeouts adjusted accordingly.

cmd_lead(){
  local lead_agent="$1"; shift; local briefing="$*"
  lead_agent=$(normalize_agent "$lead_agent")
  local lead_name; lead_name=$(get_agent_name "$lead_agent")

  # ─── Controls ───
  local max_rounds="${MAS_LEAD_MAX_ROUNDS:-10}"
  local soft_timeout="${MAS_LEAD_SOFT_TIMEOUT:-300}"
  local hard_timeout="${MAS_LEAD_HARD_TIMEOUT:-900}"
  local escalate_agent="${MAS_LEAD_ESCALATE_AGENT:-bootstrap}"
  local stall_action="${MAS_LEAD_STALL_ACTION:-partial}"
  local escalate_name; escalate_name=$(get_agent_name "$escalate_agent")

  # ─── Task ledger (temp file, one JSON per line) ───
  local task_ledger; task_ledger=$(mktemp)

  local round=0
  local total_tasks_dispatched=0
  local total_tasks_completed=0
  local total_tasks_failed=0
  local total_tasks_timedout=0
  local escalation_count=0

  echo -e "${BOLD}${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${BOLD}${CYAN}║           MAS Lead Mode v2 — $lead_name directing              ${NC}"
  echo -e "${BOLD}${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
  echo -e "Project: ${BOLD}$CURRENT_PROJECT${NC} | Max rounds: $max_rounds"
  echo -e "Timeouts: soft=${soft_timeout}s hard=${hard_timeout}s | Escalate→${BOLD}$escalate_name${NC} | Stall→$stall_action"
  echo ""

  log INFO "stage=lead_start lead=$lead_agent project=$CURRENT_PROJECT max_rounds=$max_rounds soft=$soft_timeout hard=$hard_timeout escalate=$escalate_agent stall=$stall_action"

  # ─── Helper: record task to ledger ───
  record_task(){
    local task_round="$1" agent="$2" instruction="$3" issued_at="$4"
    local soft_due=$((issued_at + soft_timeout))
    local hard_due=$((issued_at + hard_timeout))
    python3 <<PY >> "$task_ledger"
import json
print(json.dumps({
  'round': $task_round, 'agent': '$agent', 'instruction': '''$(printf '%s' "$instruction" | sed "s/'/\\\\'/g")''',
  'issued_at': $issued_at, 'soft_due': $soft_due, 'hard_due': $hard_due,
  'status': 'dispatched', 'completed_at': None, 'duration_ms': None, 'error': None
}))
PY
  }

  # ─── Helper: update task status in ledger ───
  update_task_status(){
    local agent="$1" task_round="$2" status="$3" completed_at="${4:-0}" duration_ms="${5:-0}" error="${6:-}"
    python3 <<PY
import json
lines = open("$task_ledger").readlines()
out = []
updated = False
for line in lines:
    t = json.loads(line)
    if not updated and t['agent'] == '$agent' and t['round'] == $task_round and t['status'] == 'dispatched':
        t['status'] = '$status'
        t['completed_at'] = $completed_at if $completed_at else None
        t['duration_ms'] = $duration_ms if $duration_ms else None
        t['error'] = '$error' if '$error' else None
        updated = True
    out.append(json.dumps(t))
with open("$task_ledger", 'w') as f:
    f.write('\n'.join(out) + '\n')
PY
  }

  # ─── Helper: build task status report for lead agent ───
  build_task_report(){
    python3 <<PY
import json
lines = [l.strip() for l in open("$task_ledger").readlines() if l.strip()]
if not lines:
    print("[No tasks dispatched yet]")
else:
    completed = [json.loads(l) for l in lines if json.loads(l)['status'] == 'completed']
    failed = [json.loads(l) for l in lines if json.loads(l)['status'] in ('failed', 'timeout', 'escalated')]
    pending = [json.loads(l) for l in lines if json.loads(l)['status'] == 'dispatched']
    print(f"TASK LEDGER: {len(completed)} completed, {len(failed)} failed/timeout, {len(pending)} pending")
    for t in failed:
        print(f"  ⚠ {t['agent']} (round {t['round']}): {t['status']} — {t.get('error','unknown')}")
    for t in pending:
        print(f"  ⏳ {t['agent']} (round {t['round']}): still pending")
PY
  }

  # ─── Helper: dispatch a single task with timeout tracking ───
  # Sets MAS_DISPATCH_RESULT_FILE with response text, returns 0=ok 1=fail
  dispatch_task_with_watchdog(){
    local task_round="$1" target_agent="$2" target_instruction="$3"
    target_agent=$(normalize_agent "$target_agent")
    local target_name; target_name=$(get_agent_name "$target_agent")
    local issued_at; issued_at=$(date +%s)
    MAS_DISPATCH_RESULT_FILE=$(mktemp)

    echo -e "  ${YELLOW}→${NC} Dispatching to ${BOLD}$target_name${NC}..."
    record_task "$task_round" "$target_agent" "$target_instruction" "$issued_at"
    total_tasks_dispatched=$((total_tasks_dispatched + 1))

    # Dispatch with timeout = hard_timeout
    local old_timeout="$MAS_TIMEOUT"
    MAS_TIMEOUT="$hard_timeout"
    MAS_LEAD_RESPONSE_FILE=""
    send_to_agent_silent "$target_agent" "$target_instruction"
    local send_exit=$?
    MAS_TIMEOUT="$old_timeout"

    local completed_at; completed_at=$(date +%s)
    local elapsed=$((completed_at - issued_at))
    local elapsed_ms=$((elapsed * 1000))

    if [[ $send_exit -eq 0 && -n "$MAS_LEAD_RESPONSE_FILE" ]]; then
      local resp; resp=$(cat "$MAS_LEAD_RESPONSE_FILE")
      rm -f "$MAS_LEAD_RESPONSE_FILE"
      update_task_status "$target_agent" "$task_round" "completed" "$completed_at" "$elapsed_ms"
      total_tasks_completed=$((total_tasks_completed + 1))

      # Check if response came after soft timeout (warn)
      if [[ $elapsed -gt $soft_timeout ]]; then
        echo -e "  ${YELLOW}⏱${NC} $target_name responded but was slow (${elapsed}s > soft ${soft_timeout}s)"
        log WARN "stage=lead_slow_response agent=$target_agent elapsed=${elapsed}s soft=$soft_timeout"
      fi

      echo "$resp" > "$MAS_DISPATCH_RESULT_FILE"
      return 0
    else
      # ─── Timeout / failure path ───
      total_tasks_failed=$((total_tasks_failed + 1))

      if [[ $elapsed -ge $hard_timeout ]]; then
        # Hard timeout — escalate
        total_tasks_timedout=$((total_tasks_timedout + 1))
        update_task_status "$target_agent" "$task_round" "timeout" "$completed_at" "$elapsed_ms" "Hard timeout (${elapsed}s)"
        echo -e "  ${RED}⏱ HARD TIMEOUT${NC}: $target_name did not respond in ${elapsed}s"
        log ERROR "stage=lead_hard_timeout agent=$target_agent elapsed=${elapsed}s hard=$hard_timeout"

        # Auto-escalate to escalation agent
        if [[ "$target_agent" != "$escalate_agent" ]]; then
          escalation_count=$((escalation_count + 1))
          echo -e "  ${YELLOW}🚨${NC} Escalating to ${BOLD}$escalate_name${NC}..."
          log INFO "stage=lead_escalate from=$target_agent to=$escalate_agent round=$task_round"
          MAS_LEAD_RESPONSE_FILE=""
          send_to_agent_silent "$escalate_agent" "ESCALATION: $target_name timed out (${elapsed}s) on task in project $CURRENT_PROJECT round $task_round. Task was: $target_instruction. Investigate: check agent health, model availability, session locks. Report status and any remediation."
          if [[ $? -eq 0 && -n "$MAS_LEAD_RESPONSE_FILE" ]]; then
            local esc_resp; esc_resp=$(cat "$MAS_LEAD_RESPONSE_FILE")
            rm -f "$MAS_LEAD_RESPONSE_FILE"
            cat > "$MAS_DISPATCH_RESULT_FILE" <<ESCEOF
[TIMEOUT: $target_name did not respond after ${elapsed}s. Escalated to $escalate_name.]
--- $escalate_name escalation report ---
$esc_resp
--- end escalation ---
ESCEOF
            return 1
          fi
        fi

        echo "[TIMEOUT: $target_name did not respond after ${elapsed}s. Escalation attempted.]" > "$MAS_DISPATCH_RESULT_FILE"
        return 1
      else
        # Regular failure (not timeout)
        update_task_status "$target_agent" "$task_round" "failed" "$completed_at" "$elapsed_ms" "Agent call failed"
        echo -e "  ${RED}✗${NC} $target_name failed (${elapsed}s)"
        echo "[ERROR: $target_name failed to respond (${elapsed}s)]" > "$MAS_DISPATCH_RESULT_FILE"
        return 1
      fi
    fi
  }

  # ─── Initial briefing ───
  local lead_prompt="You are the lead facilitator for this MAS research project.

TEAM:
- Wang (researcher): Deep research, financial analysis, data extraction
- Lynch (auditor): Conflict resolution, fact validation, evidence weighing
- Bootstrap (IT): System maintenance, infrastructure, escalation handler

YOUR ROLE: Direct the team. Issue tasks to other agents. Synthesize results.

TASK PROTOCOL:
When you need another agent to do something, write a task block:
  [TASK:wang] Your instruction to Wang here
  [TASK:lynch] Your instruction to Lynch here

You can issue multiple tasks in one response.
When all research is complete and you have a final answer, write:
  [DONE] Your final synthesis/conclusion here

TIMEOUT HANDLING:
- If an agent times out or fails, you will receive a timeout/error report
- You may: reassign the task to another agent, proceed with partial data, or skip
- Use [TASK:bootstrap] to investigate infrastructure issues
- You can write [DONE] with partial findings if enough evidence exists

STAGE GATE — DO NOT STOP PREMATURELY:
This project follows a MANDATORY 5-stage research protocol:
  Stage 1: External Thesis Map (gather external views before modeling)
  Stage 2: DCF Valuation Model (build your own model)
  Stage 3: Follow-Up Research / Deep-Dive (fill gaps, additional analysis)
  Stage 4: Lynch Audit (independent validation of your work)
  Stage 5: Final Synthesis (integrate audit findings, produce final report)

CRITICAL RULES:
- Do NOT write [DONE] until Stage 4 (Lynch Audit) is COMPLETE
- Do NOT write [DONE] if there are still [MISSING:] items unresolved
- Only write [DONE] after: Wang completes research → Lynch audits → You synthesize
- If unsure whether to continue, ALWAYS lean toward more research, not less

STALL POLICY: If multiple agents stall, synthesize what you have and note gaps explicitly.

RULES:
- Be specific in task instructions
- After receiving agent responses, analyze them before issuing more tasks
- Flag conflicts between agents explicitly
- Aim for thoroughness but don't loop unnecessarily
- You MUST use [TASK:agent] or [DONE] in every response
- Mark missing evidence clearly with [MISSING: description]

BRIEFING: $briefing"

  local lead_message="$lead_prompt"
  local task_results=""

  while [[ $round -lt $max_rounds ]]; do
    round=$((round + 1))
    echo -e "${BOLD}═══ Round $round / $max_rounds ═══${NC}"
    echo ""

    # If we have task results from previous round, prepend them
    if [[ -n "$task_results" ]]; then
      local task_report; task_report=$(build_task_report)
      lead_message="STAGE GATE REMINDER: Continue working through all 5 stages.
- Stage 1 (External Thesis): Done if external research gathered
- Stage 2 (DCF Model): Done if valuation model built
- Stage 3 (Follow-Up Research): Continue if gaps remain
- Stage 4 (Lynch Audit): Must be dispatched after Stage 3
- Stage 5 (Final Synthesis): Only after Lynch audit complete

Do NOT write [DONE] until Lynch has audited and you have synthesized findings.

$task_report

Here are the results from the tasks you assigned:

$task_results

Based on these results, continue your analysis. Issue more [TASK:agent] blocks if needed, or write [DONE] with your final conclusion.
If any agent timed out or failed, decide: reassign, proceed with partial data, or escalate to bootstrap."
    fi

    # Send to lead agent
    echo -e "  ${YELLOW}→${NC} Asking ${BOLD}$lead_name${NC}..."
    MAS_LEAD_RESPONSE_FILE=""
    send_to_agent_silent "$lead_agent" "$lead_message"
    if [[ $? -ne 0 || -z "$MAS_LEAD_RESPONSE_FILE" ]]; then
      # Lead agent itself failed — this is critical
      echo -e "  ${RED}✗${NC} Lead agent failed!"

      # ─── Feature 5: Stall-safe synthesis ───
      if [[ "$stall_action" == "partial" && $total_tasks_completed -gt 0 ]]; then
        echo -e "  ${YELLOW}📋${NC} Stall-safe mode: synthesizing partial results..."
        local partial_report; partial_report=$(build_task_report)
        echo ""
        echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
        echo -e "${YELLOW}Partial Synthesis [MAS:${CURRENT_PROJECT}] (lead stalled):${NC}"
        echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
        echo "$partial_report"
        echo ""
        echo "Last task results before stall:"
        echo "$task_results"
        echo ""
        log WARN "stage=lead_stall_partial lead=$lead_agent round=$round completed=$total_tasks_completed failed=$total_tasks_failed"
      else
        emit_error "lead_loop" "Lead agent ($lead_name) failed to respond in round $round"
      fi
      rm -f "$task_ledger"
      return 1
    fi

    local lead_text
    lead_text=$(cat "$MAS_LEAD_RESPONSE_FILE")
    rm -f "$MAS_LEAD_RESPONSE_FILE"

    # Check for [DONE]
    if echo "$lead_text" | grep -q '\[DONE\]'; then
      echo -e "${GREEN}${BOLD}═══ $lead_name concluded the research ═══${NC}"
      echo ""
      echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
      echo -e "${BLUE}${lead_name} — Final Conclusion [MAS:${CURRENT_PROJECT}]:${NC}"
      echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
      echo "$lead_text"
      echo ""

      # Print run summary
      echo -e "${DIM}────────────────────────────────────────────${NC}"
      echo -e "${DIM}Rounds: $round | Tasks: $total_tasks_dispatched dispatched, $total_tasks_completed completed, $total_tasks_failed failed, $total_tasks_timedout timeout | Escalations: $escalation_count${NC}"
      echo ""

      log INFO "stage=lead_done lead=$lead_agent rounds=$round project=$CURRENT_PROJECT tasks_dispatched=$total_tasks_dispatched tasks_completed=$total_tasks_completed tasks_failed=$total_tasks_failed tasks_timeout=$total_tasks_timedout escalations=$escalation_count"
      rm -f "$task_ledger"
      return 0
    fi

    # Parse [TASK:agent] blocks
    local tasks_found=0
    task_results=""

    local task_file; task_file=$(mktemp)
    local lead_text_file; lead_text_file=$(mktemp)
    printf '%s' "$lead_text" > "$lead_text_file"
    python3 <<PY > "$task_file"
import re, json
with open("$lead_text_file") as f:
    text = f.read()
pattern = r'\[TASK:(\w+)\]\s*(.*?)(?=\[TASK:|\[DONE\]|$)'
tasks = re.findall(pattern, text, re.DOTALL)
for agent, instruction in tasks:
    instruction = instruction.strip()
    if instruction:
        print(json.dumps({'agent': agent.lower(), 'instruction': instruction}))
PY
    rm -f "$lead_text_file"

    if [[ ! -s "$task_file" ]]; then
      echo -e "  ${YELLOW}⚠${NC} $lead_name didn't issue any [TASK:] or [DONE] blocks."
      echo -e "  ${DIM}Nudging to follow protocol...${NC}"
      lead_message="You must use [TASK:agent] blocks to assign work or [DONE] to conclude. Please restate your instructions using the correct format."
      rm -f "$task_file"
      continue
    fi

    # ─── Dispatch each task with watchdog ───
    while IFS= read -r task_json; do
      local target_agent target_instruction
      target_agent=$(echo "$task_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['agent'])")
      target_instruction=$(echo "$task_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['instruction'])")

      local target_name; target_name=$(get_agent_name "$target_agent")
      tasks_found=$((tasks_found + 1))

      MAS_DISPATCH_RESULT_FILE=""
      dispatch_task_with_watchdog "$round" "$target_agent" "$target_instruction"
      local task_exit=$?
      local task_response=""
      [[ -n "$MAS_DISPATCH_RESULT_FILE" && -f "$MAS_DISPATCH_RESULT_FILE" ]] && { task_response=$(cat "$MAS_DISPATCH_RESULT_FILE"); rm -f "$MAS_DISPATCH_RESULT_FILE"; }

      if [[ $task_exit -eq 0 ]]; then
        task_results="${task_results}
--- ${target_name}'s response (round $round) ---
${task_response}
--- end ${target_name} ---
"
      else
        # Failed or timed out — include the error/escalation report
        task_results="${task_results}
--- ${target_name} (round $round) — FAILED/TIMEOUT ---
${task_response}
--- end ${target_name} ---
"
      fi
    done < "$task_file"
    rm -f "$task_file"

    echo -e "  ${GREEN}✓${NC} Round $round: $tasks_found task(s) dispatched ($total_tasks_completed ok, $total_tasks_failed fail)"
    echo ""

  done

  # ─── Max rounds: force conclusion ───
  echo -e "${YELLOW}${BOLD}═══ Max rounds ($max_rounds) reached ═══${NC}"
  local task_report; task_report=$(build_task_report)

  if [[ "$stall_action" == "partial" ]]; then
    echo -e "Asking $lead_name for stall-safe partial conclusion..."
    send_to_agent "$lead_agent" "Maximum rounds ($max_rounds) reached.

$task_report

You MUST provide your [DONE] final conclusion NOW based on all available context.
If evidence is incomplete, note gaps with [MISSING: description] and synthesize what you have.
Do not request more tasks. Conclude."
  else
    echo -e "Asking $lead_name for final conclusion..."
    send_to_agent "$lead_agent" "Maximum rounds reached. Provide your [DONE] final conclusion now based on all available context."
  fi

  echo ""
  echo -e "${DIM}────────────────────────────────────────────${NC}"
  echo -e "${DIM}Rounds: $max_rounds (max) | Tasks: $total_tasks_dispatched dispatched, $total_tasks_completed completed, $total_tasks_failed failed, $total_tasks_timedout timeout | Escalations: $escalation_count${NC}"
  echo ""

  log WARN "stage=lead_max_rounds lead=$lead_agent rounds=$max_rounds project=$CURRENT_PROJECT tasks=$total_tasks_dispatched completed=$total_tasks_completed failed=$total_tasks_failed timeout=$total_tasks_timedout escalations=$escalation_count"
  rm -f "$task_ledger"
}

# ─── Diagnostics: ping ───
cmd_ping(){
  local agent; agent=$(normalize_agent "$1")
  local agent_id; agent_id=$(get_agent_id "$agent")
  local agent_name; agent_name=$(get_agent_name "$agent")
  [[ "$OUTPUT_JSON" -eq 0 ]] && echo -e "Pinging ${BOLD}$agent_name${NC} ($agent_id)..."

  local output_file err_file exit_code t_start t_end duration_ms
  output_file=$(mktemp); err_file=$(mktemp)
  t_start=$(date +%s)
  openclaw agent --agent "$agent_id" --message "Reply with exactly: PONG" --json --timeout 120 > "$output_file" 2> "$err_file"
  exit_code=$?
  t_end=$(date +%s)
  duration_ms=$(( (t_end - t_start) * 1000 ))

  local model="" provider="" response_ok=false response_text=""
  if [[ $exit_code -eq 0 ]]; then
    local struct_file; struct_file=$(mktemp)
    extract_structured_response "$output_file" > "$struct_file" 2>/dev/null
    if check_extraction_error "$struct_file" >/dev/null 2>&1; then
      response_ok=true
      response_text=$(python3 - <<PY
import json
with open("$struct_file") as f: s=json.load(f)
print(s.get('text','')[:80])
PY
)
      model=$(python3 - <<PY
import json
with open("$struct_file") as f: s=json.load(f)
print(s.get('model',''))
PY
)
      provider=$(python3 - <<PY
import json
with open("$struct_file") as f: s=json.load(f)
print(s.get('provider',''))
PY
)
    fi
    rm -f "$struct_file"
  fi

  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    local py_ok="False"; [[ "$response_ok" == "true" ]] && py_ok="True"
    python3 <<PY
import json
print(json.dumps({
  'status': 'ok' if $py_ok else 'error',
  'agent': '$agent', 'agent_id': '$agent_id', 'agent_name': '$agent_name',
  'exit_code': $exit_code, 'duration_ms': $duration_ms,
  'response_ok': $py_ok,
  'response_text': '''$response_text''',
  'model': '''$model''', 'provider': '''$provider'''
}, ensure_ascii=False, indent=2))
PY
  else
    if [[ "$response_ok" == "true" ]]; then
      echo -e "${GREEN}✓ $agent_name${NC} responded in ${duration_ms}ms"
      echo -e "  Model: ${CYAN}$model${NC} (via $provider)"
      echo -e "  Response: ${DIM}$response_text${NC}"
    else
      echo -e "${RED}✗ $agent_name${NC} failed (exit=$exit_code, ${duration_ms}ms)"
      [[ -s "$err_file" ]] && { echo -e "${DIM}"; tail -5 "$err_file"; echo -e "${NC}"; }
    fi
  fi
  rm -f "$output_file" "$err_file"
}

# ─── Diagnostics: doctor ───
cmd_doctor(){
  local issues=0
  echo -e "${BOLD}MAS v${MAS_VERSION} Doctor${NC}"
  echo ""

  # 1. OpenClaw CLI
  if command -v openclaw >/dev/null 2>&1; then
    local ver; ver=$(openclaw --version 2>/dev/null)
    echo -e "${GREEN}✓${NC} OpenClaw CLI: $ver"
  else
    echo -e "${RED}✗${NC} OpenClaw CLI not found in PATH"
    issues=$((issues+1))
  fi

  # 2. Gateway
  if openclaw health >/dev/null 2>&1; then
    echo -e "${GREEN}✓${NC} Gateway: healthy"
  else
    echo -e "${RED}✗${NC} Gateway: not responding"
    issues=$((issues+1))
  fi

  # 3. SQLite DB
  if [[ -f "$DB_FILE" ]]; then
    local integrity; integrity=$(python3 <<PY
import sqlite3
conn=sqlite3.connect("$DB_FILE"); cur=conn.cursor()
cur.execute("PRAGMA integrity_check"); r=cur.fetchone(); conn.close()
print(r[0] if r else 'unknown')
PY
)
    if [[ "$integrity" == "ok" ]]; then
      local total; total=$(python3 <<PY
import sqlite3
conn=sqlite3.connect("$DB_FILE"); cur=conn.cursor()
cur.execute("SELECT COUNT(*) FROM exchanges"); print(cur.fetchone()[0]); conn.close()
PY
)
      echo -e "${GREEN}✓${NC} Blackboard DB: ok ($total exchanges)"
    else
      echo -e "${RED}✗${NC} Blackboard DB: integrity=$integrity"
      issues=$((issues+1))
    fi
  else
    echo -e "${YELLOW}△${NC} Blackboard DB: not yet created (will auto-create on first use)"
  fi

  # 4. State file
  if [[ -f "$STATE_FILE" ]]; then
    echo -e "${GREEN}✓${NC} State: project=$CURRENT_PROJECT session=$CURRENT_SID"
  else
    echo -e "${YELLOW}△${NC} State file: not found (will auto-create)"
  fi

  # 5. Lock dir
  if [[ -d "$LOCK_DIR" ]]; then
    local lock_age
    lock_age=$(( $(date +%s) - $(stat -f %m "$LOCK_DIR" 2>/dev/null || echo 0) ))
    if [[ $lock_age -gt 120 ]]; then
      echo -e "${RED}✗${NC} Stale lock detected (age=${lock_age}s) — run: rmdir $LOCK_DIR"
      issues=$((issues+1))
    else
      echo -e "${YELLOW}△${NC} Lock held (age=${lock_age}s) — another MAS process may be running"
    fi
  else
    echo -e "${GREEN}✓${NC} No stale locks"
  fi

  # 6. Config file
  if [[ -f "$CONFIG_FILE" ]]; then
    local agent_count; agent_count=$(python3 <<PY
import json
with open("$CONFIG_FILE") as f: data=json.load(f)
print(len(data.get('agents',{})))
PY
)
    echo -e "${GREEN}✓${NC} Config: $agent_count agents configured"
  else
    echo -e "${YELLOW}△${NC} Config file not found: $CONFIG_FILE"
  fi

  # 7. Agent models
  echo ""
  echo -e "${BOLD}Agent models:${NC}"
  for agent in archie wang lynch alonzo bootstrap; do
    local idx; idx=$(agent_index_for_model "$agent")
    local path="agents.list[${idx}].model.primary"
    local model; model=$(openclaw config get "$path" 2>/dev/null)
    if [[ -n "$model" ]]; then
      echo -e "  ${GREEN}✓${NC} $(get_agent_name "$agent"): $model"
    else
      echo -e "  ${RED}✗${NC} $(get_agent_name "$agent"): no model configured"
      issues=$((issues+1))
    fi
  done

  echo ""
  if [[ $issues -eq 0 ]]; then
    echo -e "${GREEN}All checks passed.${NC}"
  else
    echo -e "${YELLOW}$issues issue(s) found.${NC}"
  fi
}

# ─── Status / context / reset ───
show_status(){
  ensure_db; migrate_legacy_json_if_needed
  python3 <<PY
import sqlite3, json
conn=sqlite3.connect("$DB_FILE"); cur=conn.cursor()
cur.execute("SELECT COUNT(*) FROM exchanges WHERE mas_session_id=?", ("$CURRENT_SID",)); count=cur.fetchone()[0]
cur.execute("SELECT COUNT(*) FROM exchanges WHERE project=?", ("$CURRENT_PROJECT",)); pcount=cur.fetchone()[0]
cur.execute("SELECT COUNT(*) FROM exchanges"); total=cur.fetchone()[0]
cur.execute("SELECT agent, openclaw_session_id, updated_at FROM mas_agent_sessions WHERE mas_session_id=? ORDER BY agent", ("$CURRENT_SID",)); rows=cur.fetchall()
conn.close()
out={'version':'$MAS_VERSION','current_project':'$CURRENT_PROJECT','current_mas_session_id':'$CURRENT_SID','db_file':'$DB_FILE','session_exchange_count':count,'project_exchange_count':pcount,'total_exchange_count':total,'agent_sessions':[{'agent':a,'openclaw_session_id':s,'updated_at':u} for a,s,u in rows]}
if $OUTPUT_JSON: print(json.dumps(out, ensure_ascii=False, indent=2))
else:
    print(f"\n${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}")
    print(f"${CYAN}║              MAS v$MAS_VERSION — Project Context Status              ║${NC}")
    print(f"${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}\n")
    print(f"Project: ${BOLD}{out['current_project']}${NC}")
    print(f"MAS session: {out['current_mas_session_id']}")
    print(f"Session exchanges: {out['session_exchange_count']}")
    print(f"Project exchanges: {out['project_exchange_count']}")
    print(f"Total DB exchanges: {out['total_exchange_count']}\n")
    if out['agent_sessions']:
        print('${BOLD}Per-agent MAS sessions:${NC}')
        for r in out['agent_sessions']:
            print(f"  - {r['agent']}: {r['openclaw_session_id']} (updated {r['updated_at']})")
    else: print('No agent MAS sessions yet in this session.')
PY
}

show_context(){
  ensure_db; migrate_legacy_json_if_needed
  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    get_context_for_agent "$CURRENT_SID" json
  else
    get_context_for_agent "$CURRENT_SID" text
  fi
}

reset_context(){
  local sid="mas-${CURRENT_PROJECT}-$(date +%Y%m%d-%H%M%S)"
  set_state_fields "$CURRENT_PROJECT" "$sid"
  CURRENT_SID="$sid"
  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    printf '{"status":"ok","project":"%s","new_mas_session_id":"%s"}\n' "$CURRENT_PROJECT" "$sid"
  else
    echo -e "${GREEN}✓${NC} New MAS session for '${BOLD}$CURRENT_PROJECT${NC}': $sid"
  fi
}

# ─── Help ───
show_help(){
  cat <<EOF
${BOLD}MAS v${MAS_VERSION}${NC} — Multi-Agent System with project-scoped shared context

${BOLD}PROJECT MANAGEMENT:${NC}
  mas new <project>               Create and switch to a new project
  mas use <project>               Switch to an existing project
  mas projects                    List all projects
  mas project                     Show current project (quick)
  mas status                      Full status overview
  mas context                     Show recent shared context
  mas reset                       New MAS session within current project

${BOLD}AGENT MESSAGING:${NC}
  mas @<agent> <message>          Send to agent (within current project)
  mas @all <message>              Broadcast to all configured agents
  mas lead @<agent> <briefing>    Autonomous facilitation with watchdog:
                                  lead agent directs via [TASK:agent] blocks
                                  auto-dispatched with timeout tracking
                                  auto-escalation on stall, partial synthesis

${BOLD}MODEL SWITCHING:${NC}
  mas model <agent>               Interactive model picker
  mas model <agent> current       Show current model
  mas model <agent> set <alias>   Set model by alias
  mas models                      Show all agent models

${BOLD}DIAGNOSTICS:${NC}
  mas ping <agent>                Health-check an agent (roundtrip test)
  mas doctor                      Full system diagnostics
  mas version                     Show MAS version

${BOLD}OPTIONS:${NC}
  --json                          Machine-readable JSON output
  --no-color                      Disable ANSI colors
  MAS_TIMEOUT=<seconds>           Override agent call timeout (default: 600)
  MAS_LEAD_MAX_ROUNDS=<n>         Max facilitation rounds (default: 10)
  MAS_LEAD_SOFT_TIMEOUT=<s>       Soft timeout per task in seconds (default: 180)
  MAS_LEAD_HARD_TIMEOUT=<s>       Hard timeout — triggers escalation (default: 480)
  MAS_LEAD_ESCALATE_AGENT=<name>  Agent for stall escalation (default: bootstrap)
  MAS_LEAD_STALL_ACTION=<action>  On stall: partial|abort (default: partial)

${BOLD}MODEL ALIASES:${NC}
  claude-opus-4, claude-opus-4.6, claude-sonnet-4.6, gpt-4.1-mini, gpt-5.4,
  gpt-5.3-codex, qwen-3.5-plus, qwen-3-max, glm-5-turbo, doubao-seed,
  grok-4.2, kimi, minimax, local-qwen, local-phi4
EOF
}

# ─── Main ───
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) OUTPUT_JSON=1; shift ;;
    --no-color) NO_COLOR=1; auto_color; shift ;;
    *) POSITIONAL+=("$1"); shift ;;
  esac
done
if [[ ${#POSITIONAL[@]} -gt 0 ]]; then
  set -- "${POSITIONAL[@]}"
else
  set --
fi

ensure_db; migrate_legacy_json_if_needed; init_state
CURRENT_PROJECT=$(get_current_project); [[ -z "$CURRENT_PROJECT" ]] && CURRENT_PROJECT=default
CURRENT_SID=$(get_current_mas_session_id); [[ -z "$CURRENT_SID" ]] && CURRENT_SID="mas-${CURRENT_PROJECT}-$(date +%Y%m%d)"

case "${1:-}" in
  new) shift; new_project "${*:-}" ;;
  use) shift; use_project "${*:-}" ;;
  projects|ls) list_projects ;;
  project|whoami) show_project_quick ;;
  status|st) show_status ;;
  context|ctx) show_context ;;
  reset|clear) reset_context ;;
  model)
    agent="${2:-}"; action="${3:-}"; value="${4:-}"
    [[ -z "$agent" ]] && { echo "Usage: mas model <agent> [current|set <alias>]"; exit 1; }
    case "$action" in
      "") model_menu "$agent" ;; current) show_model "$agent" ;;
      set) [[ -z "$value" ]] && { echo "Usage: mas model <agent> set <alias>"; exit 1; }; set_model "$agent" "$value" ;;
      *) emit_error "usage" "Unknown model action: $action" ;;
    esac ;;
  models) models_overview ;;
  ping) [[ -z "${2:-}" ]] && { echo "Usage: mas ping <agent>"; exit 1; }; cmd_ping "$2" ;;
  doctor|doc) cmd_doctor ;;
  version|--version|-v) echo "MAS v${MAS_VERSION}" ;;
  lead)
    lead_target="${2:-}"
    [[ -z "$lead_target" ]] && { echo "Usage: mas lead @<agent> <briefing>"; exit 1; }
    shift 2
    [[ -z "${1:-}" ]] && { echo "Usage: mas lead @<agent> <briefing>"; exit 1; }
    cmd_lead "$lead_target" "$*" ;;
  @archie|@wang|@lynch|@alonzo|@bootstrap|@bob) cmd="$1"; shift; send_to_agent "$cmd" "$*" ;;
  @all) shift; broadcast "$*" ;;
  help|--help|-h) show_help ;;
  "") show_help ;;
  *) emit_error "usage" "Unknown command: ${1:-}" "Run: mas help"; exit 1 ;;
esac
