#!/bin/bash
# MAS Hub Production Setup
# Reads .env.production and configures all Hermes agent profiles
#
# Routes each agent to the correct API endpoint based on model prefix:
#   zenmux/*    → ZENMUX_BASE_URL   + ZENMUX_API_KEY
#   moonshot/*  → KIMI_BASE_URL     + KIMI_API_KEY
#   minimax/*   → MINIMAX_BASE_URL  + MINIMAX_API_KEY
#   glm-*       → BIGMODEL_BASE_URL + BIGMODEL_API_KEY
#   *           → OpenRouter        + OPENROUTER_API_KEY
#
# Usage: ./bin/mas-setup-production [--dry-run]

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="${SCRIPT_DIR}/../.env.production"
HERMES_PROFILES="${HOME}/.hermes/profiles"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'
DRY_RUN=0
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1

# ─── Load .env.production ───
if [[ ! -f "$ENV_FILE" ]]; then
  echo -e "${RED}Error:${NC} .env.production not found at $ENV_FILE"
  exit 1
fi

# Source .env but don't override vars already set in environment
set -a
while IFS='=' read -r key value; do
  # Skip comments and empty lines
  [[ "$key" =~ ^#.*$ || -z "$key" ]] && continue
  # Strip leading/trailing whitespace from key
  key=$(echo "$key" | xargs)
  # Only set if not already in environment and value is non-empty
  value="${value%%#*}"  # strip inline comments
  value=$(echo "$value" | xargs)  # trim whitespace
  if [[ -n "$value" && -z "${!key:-}" ]]; then
    export "$key=$value"
  fi
done < "$ENV_FILE"
set +a

echo -e "${BOLD}${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}${CYAN}║           MAS Hub — Production Configuration                  ║${NC}"
echo -e "${BOLD}${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
echo ""
[[ $DRY_RUN -eq 1 ]] && echo -e "${YELLOW}DRY RUN — no changes will be made${NC}" && echo ""

# ─── Apply defaults for base URLs ───
KIMI_BASE_URL="${KIMI_BASE_URL:-https://api.moonshot.cn/v1}"
MINIMAX_BASE_URL="${MINIMAX_BASE_URL:-https://api.minimax.chat/v1}"
BIGMODEL_BASE_URL="${BIGMODEL_BASE_URL:-https://open.bigmodel.cn/api/paas/v4}"
GEMINI_BASE_URL="${GEMINI_BASE_URL:-https://generativelanguage.googleapis.com/v1beta/openai/}"

# ─── Show detected providers ───
echo -e "${BOLD}Providers:${NC}"
show_provider(){ local name="$1" key="$2" url="$3"
  if [[ -n "$key" ]]; then
    echo -e "  ${GREEN}✓${NC} $name: ${DIM}${key:0:8}...${NC}  →  ${url}"
  else
    echo -e "  ${DIM}–${NC} $name: ${DIM}(not set)${NC}"
  fi
}
show_provider "Zenmux"     "${ZENMUX_API_KEY:-}"     "${ZENMUX_BASE_URL:-}"
show_provider "Kimi"       "${KIMI_API_KEY:-}"        "$KIMI_BASE_URL"
show_provider "MiniMax"    "${MINIMAX_API_KEY:-}"     "$MINIMAX_BASE_URL"
show_provider "BigModel"   "${BIGMODEL_API_KEY:-}"    "$BIGMODEL_BASE_URL"
show_provider "Gemini"     "${GEMINI_API_KEY:-}"      "$GEMINI_BASE_URL"
show_provider "OpenRouter" "${OPENROUTER_API_KEY:-}"  "https://openrouter.ai/api/v1"
echo ""

# ─── Check at least one provider is configured ───
if [[ -z "${ZENMUX_API_KEY:-}" && -z "${KIMI_API_KEY:-}" && -z "${MINIMAX_API_KEY:-}" && -z "${BIGMODEL_API_KEY:-}" && -z "${GEMINI_API_KEY:-}" && -z "${OPENROUTER_API_KEY:-}" ]]; then
  echo -e "${RED}No API keys configured. Fill in .env.production and re-run.${NC}"
  exit 1
fi

# ─── Defaults ───
ARCHIE_MODEL="${ARCHIE_MODEL:-moonshot/kimi-k2.5}"
WANG_MODEL="${WANG_MODEL:-BigModel/glm-5}"
LYNCH_MODEL="${LYNCH_MODEL:-zenmux/openai/gpt-4.1-mini}"
BOOTSTRAP_MODEL="${BOOTSTRAP_MODEL:-zenmux/qwen/qwen3.5-plus}"
ALONZO_MODEL="${ALONZO_MODEL:-minimax/MiniMax-M2.7}"

# ─── Resolve provider for a model string ───
# Returns: api_key base_url provider_name
resolve_provider(){
  local model="$1"
  case "$model" in
    zenmux/*)
      echo "${ZENMUX_API_KEY:-}" "${ZENMUX_BASE_URL:-}" "zenmux" ;;
    moonshot/*|kimi*)
      echo "${KIMI_API_KEY:-}" "$KIMI_BASE_URL" "kimi" ;;
    minimax/*|MiniMax/*)
      echo "${MINIMAX_API_KEY:-}" "$MINIMAX_BASE_URL" "minimax" ;;
    glm-*|z-ai/*|bigmodel/*|BigModel/*)
      echo "${BIGMODEL_API_KEY:-}" "$BIGMODEL_BASE_URL" "bigmodel" ;;
    gemini/*|google/gemini*)
      echo "${GEMINI_API_KEY:-}" "$GEMINI_BASE_URL" "gemini" ;;
    ollama/*)
      echo "" "http://localhost:11434/v1" "ollama" ;;
    *)
      echo "${OPENROUTER_API_KEY:-}" "https://openrouter.ai/api/v1" "openrouter" ;;
  esac
}

# ─── Set a key=value in a .env file (create or replace) ───
set_env_var(){
  local file="$1" key="$2" value="$3"
  if [[ -z "$value" ]]; then return; fi
  if grep -q "^${key}=" "$file" 2>/dev/null; then
    sed -i '' "s|^${key}=.*|${key}=${value}|" "$file"
  else
    echo "${key}=${value}" >> "$file"
  fi
}

# ─── Configure each agent ───
configure_agent(){
  local agent="$1" model="$2"
  local profile_dir="${HERMES_PROFILES}/${agent}"
  local env_file="${profile_dir}/.env"

  if [[ ! -d "$profile_dir" ]]; then
    echo -e "  ${RED}✗${NC} ${BOLD}${agent}${NC} — profile missing (run install.sh first)"
    return 1
  fi

  # Resolve which provider this model needs
  local provider_info
  provider_info=$(resolve_provider "$model")
  local api_key base_url provider_name
  api_key=$(echo "$provider_info" | cut -d' ' -f1)
  base_url=$(echo "$provider_info" | cut -d' ' -f2)
  provider_name=$(echo "$provider_info" | cut -d' ' -f3)

  echo -e "  ${BOLD}${agent}${NC} → ${CYAN}${model}${NC}  ${DIM}(${provider_name} @ ${base_url})${NC}"

  if [[ -z "$api_key" && "$provider_name" != "ollama" ]]; then
    echo -e "    ${YELLOW}⚠${NC} No API key for ${provider_name} — agent may fail at runtime"
  fi

  if [[ $DRY_RUN -eq 1 ]]; then
    echo -e "    ${DIM}[DRY RUN] Would configure${NC}"
    return 0
  fi

  # 1. Set the API key that Hermes reads (OPENROUTER_API_KEY is the default it checks)
  set_env_var "$env_file" "OPENROUTER_API_KEY" "$api_key"

  # 2. Also store provider-specific keys for reference
  case "$provider_name" in
    zenmux)   set_env_var "$env_file" "ZENMUX_API_KEY" "$api_key" ;;
    kimi)     set_env_var "$env_file" "KIMI_API_KEY" "$api_key" ;;
    minimax)  set_env_var "$env_file" "MINIMAX_API_KEY" "$api_key" ;;
    bigmodel) set_env_var "$env_file" "BIGMODEL_API_KEY" "$api_key" ;;
    gemini)   set_env_var "$env_file" "GEMINI_API_KEY" "$api_key" ;;
  esac

  # 3. Set model + base_url + provider in Hermes config
  #    Strip "zenmux/" prefix — it's a MAS namespace, the API takes bare model IDs
  #    provider=auto — lets Hermes use base_url with standard Bearer auth
  local hermes_model="$model"
  hermes_model="${hermes_model#zenmux/}"
  hermes -p "$agent" config set model.default "$hermes_model" >/dev/null 2>&1
  hermes -p "$agent" config set model.base_url "$base_url" >/dev/null 2>&1
  hermes -p "$agent" config set model.provider "auto" >/dev/null 2>&1
  # Clear cached auth state to avoid stale credential issues
  rm -f "${profile_dir}/auth.json"

  echo -e "    ${GREEN}✓${NC} configured"
}

echo -e "${BOLD}Configuring agent profiles:${NC}"
echo ""
configure_agent archie    "$ARCHIE_MODEL"
configure_agent wang      "$WANG_MODEL"
configure_agent lynch     "$LYNCH_MODEL"
configure_agent bootstrap "$BOOTSTRAP_MODEL"
configure_agent alonzo    "$ALONZO_MODEL"

echo ""

# ─── Verify ───
if [[ $DRY_RUN -eq 0 ]]; then
  echo -e "${BOLD}Verification:${NC}"
  echo ""
  "${SCRIPT_DIR}/mas" models 2>&1 | sed 's/^/  /'
  echo ""
  echo -e "${GREEN}${BOLD}Production configuration complete.${NC}"
  echo ""
  echo -e "Next steps:"
  echo -e "  ${CYAN}./bin/mas-test --tier1${NC}       Quick offline validation"
  echo -e "  ${CYAN}./bin/mas-test --all${NC}         Full integration test"
  echo -e "  ${CYAN}./bin/mas ping wang${NC}          Verify connectivity"
fi
