#!/bin/bash
# MAS TUI Wrapper - For use inside OpenClaw TUI
# Usage: mas-tui <agent> <message>
# Resolves mas from the same directory as this script.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MAS_BIN="${SCRIPT_DIR}/mas"

export TUI_MODE=1
export MAS_HUB="${HOME}/.openclaw/mas-hub"

agent=$1
shift
message="$*"

if [[ -z "$agent" || -z "$message" ]]; then
    echo "Usage: mas-tui <agent> <message>"
    echo "Agents: archie, wang, lynch, bootstrap"
    exit 1
fi

case $agent in
    archie|wang|lynch|bob|bootstrap)
        "$MAS_BIN" @"$agent" "$message"
        ;;
    *)
        echo "Unknown agent: $agent"
        exit 1
        ;;
esac
